# Provayder tanlash: openrouter | radox
AGENT_PROVIDER=openrouter

# Har provayder o'z kaliti bilan ishlaydi — faqat bittasi kerak.
OPENROUTER_API_KEY=sk-or-v1-xxxx
RADOX_API_KEY=radox-xxxx

# Bo'sh qoldirsangiz provayder standart modeli olinadi.
# Model ro'yxati:  python agent.py --models
AGENT_MODEL=
